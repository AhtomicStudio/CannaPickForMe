rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Ad images — public reads, locked writes until admin auth is added
    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if false; // TODO: restrict to authenticated admin once Firebase Auth is added
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
