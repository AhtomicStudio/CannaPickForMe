rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Ad images — public reads, writes protected client-side via admin password
    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
