rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ads — public reads, open writes (admin protected client-side)
    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }

    // Strain delta — public reads, open writes (admin protected client-side)
    match /strains/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles — owner only, requires Firebase Auth
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
