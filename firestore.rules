rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ads — public reads, authenticated writes (admin signs in anonymously after password check)
    match /ads/{adId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Strain delta — public reads, authenticated writes (admin signs in anonymously after password check)
    match /strains/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles — owner only, requires Firebase Auth
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cannagotchi async-league challengers — public READ (so anyone can see the
    // leaderboard), owner-only WRITE (you can only publish/update your own bud).
    match /leagueChallengers/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Sign-in OTP codes — Cloud Functions only. Clients can never read or write
    // these directly; the codeHash + attempts counter would be a security hole.
    // Cloud Functions bypass these rules via the Admin SDK.
    match /signInCodes/{docId} {
      allow read, write: if false;
    }

    // Pages (about, lore) — public reads, admin writes
    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Info topics — public reads, admin writes
    match /info/{slug} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // Note: Game state (CannaGotchi) is stored in users/{uid}.game
    // and is already covered by the users/{uid} rule above.
  }
}
