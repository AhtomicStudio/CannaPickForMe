rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ads — public reads. Admin writes for full CRUD; public clients
    // (signed-out users on the result screen) can write ONLY the counter
    // fields so impression/click tracking works without forcing a login.
    match /ads/{adId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
      allow update: if (request.auth != null && request.auth.token.email == 'twotales89@gmail.com')
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['impressions', 'clicks', 'lastImpressionAt', 'lastClickAt']);
    }

    // Strain delta — public reads, admin writes
    match /strains/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
    }

    // Dispensaries — public reads (user-facing partner cards display the
    // dispensary name), authenticated writes.
    match /dispensaries/{slug} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
    }

    // Campaigns — public reads (the user-facing aggregator needs to see
    // what's currently live). Campaigns intentionally contain NO billing
    // or contact info — those live on advertiser docs.
    //
    // Admin auth for full writes; public clients (signed-out users) can
    // write ONLY the counter fields so impression/click tracking works.
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, delete: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
      allow update: if (request.auth != null && request.auth.token.email == 'twotales89@gmail.com')
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['impressions', 'clicks', 'lastImpressionAt', 'lastClickAt']);
    }

    // Advertisers — admin-only. Contains PII (contact email/name) and
    // billing details. Never exposed to the user-facing app.
    match /advertisers/{advertiserId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
    }

    // Migration sentinel — admin-only.
    match /system/{key} {
      allow read, write: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
    }

    // User profiles — owner only, requires Firebase Auth
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cannagotchi async-league challengers — public READ (so anyone can see the
    // leaderboard), owner-only WRITE (you can only publish/update your own bud).
    match /leagueChallengers/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Battle rooms — real-time PvP via Online Battle mode.
    //   • Anyone authenticated can CREATE a room (setDoc).
    //   • Anyone authenticated can READ a room (to join or watch the state).
    //   • Only the host or guest may UPDATE their room once it exists.
    //   • Only the host may DELETE (cleanup) their own room.
    match /battleRooms/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || resource.data.guestUid == request.auth.uid
                        || resource.data.guestUid == null);
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // Sign-in OTP codes — Cloud Functions only. Clients can never read or write
    // these directly; the codeHash + attempts counter would be a security hole.
    // Cloud Functions bypass these rules via the Admin SDK.
    match /signInCodes/{docId} {
      allow read, write: if false;
    }

    // Pages (about, lore) — public reads, admin writes
    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
    }

    // Info topics — public reads, admin writes
    match /info/{slug} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'twotales89@gmail.com';
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }

    // Note: Game state (CannaGotchi) is stored in users/{uid}.game
    // and is already covered by the users/{uid} rule above.
  }
}
